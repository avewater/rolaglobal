{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/",               "destination": "/index.html" },
    { "source": "/home",           "destination": "/index.html" },
    { "source": "/about",          "destination": "/about.html" },
    { "source": "/what-we-build",  "destination": "/what-we-build.html" },
    { "source": "/rola-report",    "destination": "/rola-report.html" },
    { "source": "/partner-inquiry","destination": "/partner-inquiry.html" },
    { "source": "/thank-you",      "destination": "/thank-you.html" },
    { "source": "/nil-infrastructure",  "destination": "/article_pillar1_NIL_Infrastructure.html" },
    { "source": "/nil-compliance",      "destination": "/article_pillar2_NIL_Compliance.html" },
    { "source": "/revenue-sharing",     "destination": "/article_pillar3_Revenue_Sharing.html" },
    { "source": "/nil-recruiting",      "destination": "/article_pillar4_NIL_Recruiting.html" },
    { "source": "/business-entity",     "destination": "/article_pillar5_Business_Entity.html" },
    { "source": "/non-revenue-sports",  "destination": "/article_pillar6_NonRevenue_Sports.html" },
    { "source": "/financial-literacy",  "destination": "/article_pillar7_Financial_Literacy.html" },
    { "source": "/transfer-portal",     "destination": "/article_pillar8_Transfer_Portal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}